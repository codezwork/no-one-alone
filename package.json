{
  "name": "neighbours",
  "version": "1.0.0",
  "description": "Neighbours by No One Alone: find and give help within 3–4 km during a calamity, and trade essentials locally.",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "web-push": "3.6.7"
  }
}

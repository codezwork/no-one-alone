# Neighbours: local settings, loaded by npm start and npm run seed.
# Copy the same names into Vercel (Settings, Environment Variables) when this works.

# Turso database. Paste the libsql:// URL and a Read & Write token from the Turso dashboard.
# Leave both empty to use the local file data/neighbours.db instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Web push keys. Keep them the same everywhere, or phones that already allowed alerts stop getting them.
# Make a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services can use to reach you (optional).
# VAPID_SUBJECT=mailto:you@example.com
